# --- Core ---
MONGO_URL=mongodb://localhost:27017
DB_NAME=rag_system

# --- LLM (swap providers here; leaves space for different AI APIs) ---
# provider: emergent | gemini | openai
LLM_PROVIDER=emergent
LLM_MODEL=gpt-5.4
# emergent universal key (dev/testing)
EMERGENT_LLM_KEY=sk-emergent-xxxx
INTEGRATION_PROXY_URL=https://integrations.emergentagent.com
# to use your own keys instead, set LLM_PROVIDER accordingly and provide:
# GEMINI_API_KEY=...
# OPENAI_API_KEY=...

# --- Local embedding / rerank models (free, CPU) ---
QDRANT_PATH=/app/rag_storage/qdrant
DENSE_MODEL=sentence-transformers/all-MiniLM-L6-v2
SPARSE_MODEL=Qdrant/bm25
RERANK_MODEL=Xenova/bge-reranker-base

# --- Real connector credentials (leave blank to use bundled mock data) ---
CONFLUENCE_BASE_URL=
CONFLUENCE_TOKEN=
CONFLUENCE_SPACES=ENG,IT
SERVICENOW_INSTANCE_URL=
SERVICENOW_TOKEN=
WORDDOCS_PATH=/path/to/word/docs
